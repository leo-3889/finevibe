{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true
  },
  "include": ["src/renderer/**/*.ts", "src/shared/**/*.ts", "src/renderer/locales/*.json"],
  "exclude": ["src/renderer/**/*.test.ts"]
}
