#!/usr/bin/env bash
# Pre-push privacy/secret gate.
#
# Installed by `npm install` (the `prepare` script sets core.hooksPath=.githooks).
#
# Reads the standard pre-push ref lines on stdin (local_ref local_sha remote_ref
# remote_sha), scans the blobs the push would publish against .secrets.patterns
# and exits non-zero, listing `[rev] file:line: content`, on any un-exempt hit.
#
# Exemptions, in order:
#   1. `pii-allow` anywhere on the offending line  — synthetic fixture
#   2. `SHA256:(pinned123|evil|attacker)`          — synthetic host-key pins
#   3. `/(home|Users)/<fixture-user>/`             — synthetic home paths (ALLOW_USERS)
#   4. path prefixes in .secrets.allowlist         — attribution metadata + scanner signatures
set -u

zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
patterns=$root/.secrets.patterns
allowlist=$root/.secrets.allowlist

# ponytail: the deny half lives in .secrets.patterns, the allow half here —
# POSIX ERE has no negative lookahead, so one file cannot carry both. Widen
# ALLOW_USERS rather than marking dozens of fixture lines with pii-allow.
# `jane` = the `jane doe` / `Jane Doe` placeholder user (row 35 spaced-path
# ssh fixtures); synthetic, like every other name here.
ALLOW_USERS='me|dev|test|testuser|user|foo|alex|jane|sample|attacker|mock|u|mcp|fake|finevibe|runner|x|my|someone'
allow_users="(^|[^A-Za-z0-9])/(home|Users)/($ALLOW_USERS)(/|[^a-z0-9._-]|\$)"
allow_sha='SHA256:(pinned123|evil|attacker)'
# Synthetic test networks: TEST-NET-1/2/3 (RFC 5737) + the fixture ranges this
# repo's hosts tests were written against (10.0.0.x, 192.168.1.x). The real
# operator LAN range (192.168.2.0/24) is NOT here and stays hard-blocked.
allow_testnet='(^|[^0-9])(10\.0\.0\.[0-9]+|192\.168\.1\.[0-9]+|192\.0\.2\.|198\.51\.100\.|203\.0\.113\.)([^0-9]|$)'

if [ ! -f "$patterns" ]; then
  echo "pre-push: $patterns not found — nothing scanned." >&2
  exit 0
fi

hits=$(mktemp) || exit 0
trap 'rm -f "$hits"' EXIT

# .secrets.allowlist -> git pathspec exclusions, one per line. Built PER REF
# from the version the REMOTE already has (the base): a push must not be able
# to widen its own exemptions by editing .secrets.allowlist in the same range.
build_excl() {  # $1: source (file path, or `git show` spec when prefixed with @)
  local src=$1
  if [ -n "$src" ] && [ -f "$src" ] || { [ "${src#@}" != "$src" ] && git cat-file -e "${src#@}" 2>/dev/null; }; then
    if [ "${src#@}" != "$src" ]; then git show "${src#@}"; else cat "$src"; fi |
      sed -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' | sed 's|^|:(exclude)|'
  fi
}

# Paths with spaces: split the file / rev / pathspec lists on newlines only.
IFS=$'\n'

# The ref lines are space-separated; IFS is newline-only below, so pin it here.
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  case $local_sha in
    '' | *[!0-9a-f]*) continue ;;   # unparsable line
    "$zero") continue ;;            # a branch delete publishes nothing
  esac
  case $remote_sha in
    '' | "$zero" | *[!0-9a-f]*) base='' ;;   # new remote ref: everything is new
    *) base=$remote_sha ;;
  esac

  revs=$(git rev-list ${base:+$base..}$local_sha 2>/dev/null)
  [ -z "$revs" ] && continue

  if [ -n "$base" ] && git cat-file -e "$base:.secrets.allowlist" 2>/dev/null; then
    # The exemptions in force are the ones the remote already carries: a push
    # cannot widen its own exemptions by editing .secrets.allowlist in range.
    excl=$(build_excl "@$base:.secrets.allowlist")
  else
    # No allowlist on the remote yet (this push ships it) — the local file,
    # with its scanner-signature self-exclusions, is the bootstrap surface.
    excl=$(build_excl "$allowlist")
  fi

  if [ -z "$base" ]; then
    # NEW remote ref: the whole TIP TREE is the surface - a new ref publishes
    # all of history, so per-rev diffs would scan one commit and ship the rest.
    # ponytail: tip tree only, not every historical blob: this repo's
    # pre-rename history already carries the fixtures it forbids (and is not
    # rewritable), so a full-history gate fires on every new branch. Upgrade
    # path: a one-off `git log -p` audit, not the push path.
    # shellcheck disable=SC2086
    git -c core.quotePath=false grep -I -n -E -f "$patterns" "$local_sha" -- $excl 2>/dev/null |
      grep -v 'pii-allow' | grep -vE "$allow_sha" | grep -vE "$allow_users" | grep -vE "$allow_testnet" |
      sed -e "s|^$local_sha:|[tip] |" >>"$hits"
    continue
  fi

  # Range pushes scan what each rev ADDS (no net-diff pathspec: a file added
  # mid-range and deleted before the tip IS published by this push and must
  # stay visible). Scanning whole blobs at every rev is the other trap: the
  # range publishes its DELETIONS (scrub commits), so whole-blob scans fire on
  # content the range removes and block the branch that ships the gate.
  for rev in $revs; do
    short=$(git rev-parse --short "$rev")
    # shellcheck disable=SC2086
    git -c core.quotePath=false show --pretty=format: "$rev" -- $excl 2>/dev/null |
      grep '^+' | grep -E -f "$patterns" |
      grep -v 'pii-allow' | grep -vE "$allow_sha" | grep -vE "$allow_users" | grep -vE "$allow_testnet" |
      sed -e "s|^|[$short] |" >>"$hits"
  done
done

if [ -s "$hits" ]; then
  sort -u "$hits"
  printf '\npre-push: the lines above match .secrets.patterns.\n' >&2
  printf 'Fix them, mark a synthetic fixture with `pii-allow` on the line, or exempt an\nattribution path in .secrets.allowlist. Push aborted.\n' >&2
  exit 1
fi

exit 0
