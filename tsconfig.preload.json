{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist/preload",
    "rootDir": "src",
    "declaration": true,
    "composite": true
  },
  "exclude": ["src/preload/**/*.test.ts"],
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts"]
}
