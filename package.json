{
  "name": "finevibe",
  "version": "0.3.9-dev",
  "description": "A terminal-centric IDE for AI-powered CLI tools, built on Electron",
  "author": {
    "name": "leo-3889",
    "email": "1493911+leo-3889@users.noreply.github.com"
  },
  "contributors": [
    {
      "name": "Eliran Tutia",
      "email": "elirantutia@gmail.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leo-3889/finevibe.git"
  },
  "homepage": "https://github.com/leo-3889/finevibe",
  "bugs": {
    "url": "https://github.com/leo-3889/finevibe/issues"
  },
  "bin": {
    "finevibe": "bin/finevibe.js"
  },
  "keywords": [
    "electron",
    "ide",
    "terminal",
    "claude",
    "claude-code",
    "ai",
    "developer-tools"
  ],
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/main/main/main.js",
  "scripts": {
    "build": "npm run build:core && npm run build:renderer && npm run copy-assets",
    "build:core": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --outfile=dist/renderer/index.js --platform=browser --format=iife --target=es2022 --minify --loader:.ts=ts",
    "dev:renderer": "npm run build:renderer -- --sourcemap",
    "copy-assets": "node scripts/copy-assets.js",
    "icons": "node scripts/build-icons.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build:core && npm run dev:renderer && npm run copy-assets && electron .",
    "postinstall": "node -e \"try{require('electron-builder/package.json');require('child_process').execSync('electron-builder install-app-deps',{stdio:'inherit'})}catch{}\"",
    "pack": "npm run build && npm run icons && electron-builder --dir",
    "dist": "npm run build && npm run icons && electron-builder",
    "win:stamp": "node scripts/edit-win-exe.mjs",
    "win:verify": "node scripts/verify-win-exe.mjs",
    "dist:win:local": "npm run build && npm run icons && npx electron-builder --win dir --x64 --publish never --config.npmRebuild=false --config.win.signAndEditExecutable=false && npm run win:stamp && npm run win:verify && npx electron-builder --win nsis zip --prepackaged dist/win-unpacked --x64 --publish never --config.npmRebuild=false --config.win.signAndEditExecutable=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main-tests.json"
  },
  "build": {
    "appId": "com.finevibe.app",
    "productName": "FineVibe",
    "icon": "build/icon.png",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "!dist/**/*.map",
      "build/icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FineVibe needs microphone access so CLI tools running in the terminal (e.g. Claude Code's /voice) can capture audio."
      },
      "notarize": true
    },
    "linux": {
      "artifactName": "FineVibe-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "win": {
      "artifactName": "FineVibe-${version}-win-${arch}.${ext}",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "FineVibe-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "FineVibe-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "leo-3889",
      "repo": "finevibe",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/picomatch": "^4.0.2",
    "@vitest/coverage-v8": "^4.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "jsdom": "^29.1.1",
    "png2icons": "^2.0.1",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.3.3",
    "electron-updater": "^6.8.3",
    "gridstack": "^12.6.0",
    "jszip": "^3.10.2",
    "marked": "^17.0.5",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.3"
  }
}
